# ─────────────────────────────────────────────────────────────────────
#  转写与润色参数模板
#
#  用法：复制到包外填好，或直接用命令行参数覆盖
#      export WHISPER_MODEL=small
#
#  ⚠️ 本文件只含占位符与默认值，可以公开。
# ─────────────────────────────────────────────────────────────────────

# 【可选】语音识别模型：tiny / base / small / medium / large
#   small 约 460MB，速度与准确率平衡最好；medium 更准但慢 3–5 倍
WHISPER_MODEL=small

# 【可选】语言代码，默认中文
WHISPER_LANGUAGE=zh

# 【可选】题材提示（给模型，能显著减少同音错字）
#   例：以下是关于NPD自恋型人格障碍、原生家庭、创伤觉醒的普通话口播逐字稿。
WHISPER_PROMPT=

# 【可选】HuggingFace 镜像，国内下载模型时用
#   模型已缓存后可用 HF_HUB_OFFLINE=1 完全离线跑
HF_ENDPOINT=https://hf-mirror.com

# 【可选】模型缓存目录（默认 ~/.cache/huggingface）
# HF_HOME=<你的家目录>/.cache/huggingface
